            local data = pet:FindFirstChild("Data")
            if data and data:FindFirstChild("Age") then
                local age = tonumber(data.Age.Value)
                if age and age >= 100 then
                    -- หา weight
                    local weight = data:FindFirstChild("Weight") and formatNumberSuffix(data.Weight.Value) or "?"
                    -- หาเงิน (Income, Cash, Production, CoinRate)
                    local income = data:FindFirstChild("Income") or data:FindFirstChild("CoinRate") or data:FindFirstChild("Cash") or data:FindFirstChild("Production")
