local function boostFPS()
    print("🚀 เปิดโหมด Ultra Boost FPS! ปิดกราฟิกและเอฟเฟคขั้นสุดเพื่อโหมดฟาร์ม...")
    pcall(function()
        settings().Rendering.QualityLevel = 1
        if UserSettings then
            UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        end
    end)

    pcall(function()
        game.Lighting.GlobalShadows = false
        game.Lighting.FogEnd = 9e9
        game.Lighting.FogStart = 9e9
        game.Lighting.Brightness = 1
        for _, effect in ipairs(game.Lighting:GetChildren()) do
            if effect:IsA("PostEffect") or effect:IsA("Atmosphere") or effect:IsA("Clouds") or effect:IsA("Sky") then
                pcall(function() effect.Enabled = false end)
            end
        end
    end)

    local blankColor = Color3.fromRGB(135, 135, 135)
    local function makeBlankModel(desc)
        pcall(function()
            if desc:IsA("BasePart") then
                desc.Material = Enum.Material.SmoothPlastic
                desc.Reflectance = 0
                desc.CastShadow = false
                desc.Color = blankColor
            end
            if desc:IsA("MeshPart") then
                desc.Material = Enum.Material.SmoothPlastic
                desc.Reflectance = 0
                desc.CastShadow = false
                desc.Color = blankColor
                pcall(function() desc.TextureID = "" end)
            end
            if desc:IsA("SpecialMesh") then
                pcall(function() desc.TextureId = "" end)
            end
            if desc:IsA("Decal") or desc:IsA("Texture") then
                desc.Transparency = 1
            end
            if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire") or desc:IsA("Beam") then
                desc.Enabled = false
            end
            if desc:IsA("Light") or desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
                desc.Enabled = false
            end
        end)
    end

    for _, desc in ipairs(workspace:GetDescendants()) do
        makeBlankModel(desc)
    end

    workspace.DescendantAdded:Connect(makeBlankModel)
end

local function farmAndLogEgg(targetEggs)
    local egg = findEggToFarm(targetEggs)
    if egg then
        local eggName = egg.Name
        local weight = "Unknown"
        pcall(function()
            for _, d in ipairs(egg:GetDescendants()) do
                if d.Name == "Weight" and d:IsA("NumberValue") then
                    weight = formatNumberSuffix(d.Value) .. " KG"
                    break
                elseif d:IsA("TextLabel") and string.find(d.Text, "KG") then
                    weight = string.gsub(d.Text, "<[^>]+>", "")
                end
            end
        end)
        
        if pickUpEgg(egg) then
            pcall(function()
                sendDiscordWebhook("Farmed " .. eggName, true, eggName, weight)
            end)
        end
    end
end

