local function extractUUID(val)
    if not val then return nil end
    local str = tostring(val)
    return string.match(str, "%w%w%w%w%w%w%w%w%-%w%w%w%w%-%w%w%w%w%-%w%w%w%w%-%w%w%w%w%w%w%w%w%w%w%w%w")
end

local function getEggKeyFromInstance(egg)
    if not egg then return nil end
    local fromName = extractUUID(egg.Name)
    if fromName then return fromName end
    local directAttr = egg:GetAttribute("EggKey") or egg:GetAttribute("Key") or egg:GetAttribute("UUID") or egg:GetAttribute("Id")
    local fromDirect = extractUUID(directAttr)
    if fromDirect then return fromDirect end
    for _, desc in ipairs(egg:GetDescendants()) do
        if desc:IsA("StringValue") then
            local fromVal = extractUUID(desc.Value)
            if fromVal then return fromVal end
        end
    end
    return nil
end

local function hatchAllEggs()
    local myPlot = getMyPlot()
    local eggsFolder = myPlot and myPlot:FindFirstChild("Eggs")
    local hatchRemote = GameRemotes:FindFirstChild("Hatch")
    
    if eggsFolder and hatchRemote then
        for _, egg in pairs(eggsFolder:GetChildren()) do
            local key = getEggKeyFromInstance(egg)
            if key then
                pcall(function()
                    hatchRemote:FireServer({EggKey = key})
                    hatchRemote:FireServer(key)
                end)
            end
        end
        
        local dataF = myPlot:FindFirstChild("Data") or myPlot:FindFirstChild("EggsData")
        if dataF then
            for _, desc in ipairs(dataF:GetDescendants()) do
                if desc:IsA("StringValue") then
                    local key = extractUUID(desc.Value)
                    if key then
                        pcall(function() hatchRemote:FireServer({EggKey = key}) end)
                    end
                end
            end
        end
    end
end

local function placeBestPet()
    pcall(function()
        local placePetRemote = GameRemotes:FindFirstChild("PlacePet")
        if placePetRemote then
            placePetRemote:FireServer({ Action = "PlaceBest" })
