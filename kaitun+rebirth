local function scanPlotEggs()
    local plot = getMyPlot()
    if not plot then return {}, 0 end

    local eggsFolder = plot:FindFirstChild("Eggs")
    if not eggsFolder then return {}, 0 end

    local counts = {}
    local total = 0
    for _, egg in ipairs(eggsFolder:GetChildren()) do
        local rawName = egg.Name
        local cleanName = string.gsub(rawName, "%[.-%]", ""):gsub("^%s*(.-)%s*$", "%1")
        counts[cleanName] = (counts[cleanName] or 0) + 1
        total = total + 1
    end
    return counts, total
end

