local function placeEggOnPlot(eggTool)
    local char, hrp, hum = getChar()
    local myPlot = getMyPlot()
    if not myPlot or not hrp or not hum then return false end
    
    local baseplate = myPlot:FindFirstChild("Baseplate")
    if not baseplate then return false end
    
    hrp.CFrame = baseplate.CFrame + Vector3.new(0, 5, 0)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.2)
    
    if eggTool.Parent ~= char then
        hum:EquipTool(eggTool)
        task.wait(0.2)
    end
    
    local plantRemote = GameRemotes:FindFirstChild("EggPlaced")
    if plantRemote then
        print("🥚 กำลังวางไข่:", eggTool.Name)
        plantRemote:FireServer({ PlantPosition = baseplate.Position })
        task.wait(1.2) -- รอ 1 วิ หลังวางไข่ ตามคำขอ
        return true
    end
    return false
end

local function getActiveEggLimits(currentRebirth)
    local maxEggs, maxVIP, maxNormal, normalEggs = 0, 0, 0, {}
    if currentRebirth == 0 then
        maxEggs = 5; maxVIP = 2; maxNormal = 3; normalEggs = {"Slime Egg", "Leaf Egg"}
    elseif currentRebirth == 1 then
        maxEggs = 6; maxVIP = 3; maxNormal = 3; normalEggs = {"Golden Egg"}
    elseif currentRebirth == 2 then
        maxEggs = 7; maxVIP = 4; maxNormal = 3; normalEggs = {"galxy Egg"}
    elseif currentRebirth == 3 then
        maxEggs = 8; maxVIP = 5; maxNormal = 3; normalEggs = {"galxy Egg"}
    elseif currentRebirth == 4 then
        maxEggs = 9; maxVIP = 9; maxNormal = 0; normalEggs = {}
    elseif currentRebirth >= 5 then
        maxEggs = 10; maxVIP = 10; maxNormal = 0; normalEggs = {}
    end
    return maxEggs, maxVIP, maxNormal, normalEggs
end

