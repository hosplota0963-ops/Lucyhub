    local myPlot = getMyPlot()
    local eggsFolder = myPlot and myPlot:FindFirstChild("Eggs")
    
    local plantedVIP, plantedNormal = 0, 0
    
    if eggsFolder then
        for _, egg in ipairs(eggsFolder:GetChildren()) do
            if egg.Name == "Cherub Egg" or egg.Name == "Blackhole Egg" or egg.Name == "Solaris Egg" then
                plantedVIP = plantedVIP + 1
            else
                for _, n in ipairs(normalEggs) do
                    if egg.Name == n then
                        plantedNormal = plantedNormal + 1
                        break
                    end
                end
            end
        end
    end
    
    local targetEggs = {}
    
    -- ถ้าโควต้า VIP ยังไม่เต็ม ให้ฟาร์ม VIP ได้
    if plantedVIP < maxVIP then
        table.insert(targetEggs, "Cherub Egg")
        table.insert(targetEggs, "Solaris Egg")
        table.insert(targetEggs, "Blackhole Egg")
    end
    
    -- ถ้าโควต้า Normal ยังไม่เต็ม ให้ฟาร์ม Normal ได้
    if plantedNormal < maxNormal then
        for _, n in ipairs(normalEggs) do
            table.insert(targetEggs, n)
        end
    end
    
    return targetEggs
end

local function plantEggsByRebirthLogic(currentRebirth)
    local myPlot = getMyPlot()
    if not myPlot then return end
    local eggsFolder = myPlot:FindFirstChild("Eggs")
    if not eggsFolder then return end
    
    local currentEggs = eggsFolder:GetChildren()
    local plantedVIPCount = 0
    local plantedNormalCount = 0
    
    local maxEggs, maxVIP, maxNormal, normalEggs = getActiveEggLimits(currentRebirth)
    
    local function isNormalEgg(eggName)
        for _, n in ipairs(normalEggs) do
            if n == eggName then return true end
        end
        return false
    end
    
    for _, egg in ipairs(currentEggs) do
        if egg.Name == "Cherub Egg" or egg.Name == "Blackhole Egg" or egg.Name == "Solaris Egg" then
            plantedVIPCount = plantedVIPCount + 1
        elseif isNormalEgg(egg.Name) then
            plantedNormalCount = plantedNormalCount + 1
        end
    end
    
    local char, _, _ = getChar()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end
    
    local totalEggs = #currentEggs
    
    local function tryPlant(eggName)
        if totalEggs >= maxEggs then return false end
        local tool = backpack:FindFirstChild(eggName) or char:FindFirstChild(eggName)
        if tool then
            local success = placeEggOnPlot(tool)
            if success then
                totalEggs = totalEggs + 1
            end
            return success
        end
        return false
    end
    
    -- ปลูก VIP Eggs ให้ครบโควต้า (Cherub > Solaris > Blackhole)
    local vipPriority = {"Cherub Egg", "Solaris Egg", "Blackhole Egg"}
    while plantedVIPCount < maxVIP and totalEggs < maxEggs do
        local plantedAny = false
        for _, vipName in ipairs(vipPriority) do
            if tryPlant(vipName) then
                plantedVIPCount = plantedVIPCount + 1
                plantedAny = true
                break
            end
        end
        if not plantedAny then break end -- หมดไข่ VIP ในตัว
    end
    
    -- ปลูก Normal Eggs ให้ครบโควต้า
    if #normalEggs > 0 then
        while plantedNormalCount < maxNormal and totalEggs < maxEggs do
            local plantedAny = false
            for _, nName in ipairs(normalEggs) do
                if tryPlant(nName) then
                    plantedNormalCount = plantedNormalCount + 1
                    plantedAny = true
                    break
                end
            end
            if not plantedAny then break end -- หมดไข่ Normal ทุกชนิดในตัว
        end
    end
    
    -- [Failsafe] กำจัดไข่ที่ค้างอยู่ในกระเป๋า (ป้องกันตะกร้าเต็มแล้วบัคค้าง)
    if totalEggs < maxEggs then
        local tools = {}
        for _, obj in ipairs(backpack:GetChildren()) do 
            if obj:IsA("Tool") and string.find(string.lower(obj.Name), "egg") then table.insert(tools, obj) end 
        end
        for _, obj in ipairs(char:GetChildren()) do 
            if obj:IsA("Tool") and string.find(string.lower(obj.Name), "egg") then table.insert(tools, obj) end 
        end
        
        for _, t in ipairs(tools) do
            if totalEggs >= maxEggs then break end
            local success = placeEggOnPlot(t)
            if success then
                totalEggs = totalEggs + 1
            end
        end
    end
end

