                    end
                    table.insert(maxPets, string.format("• **%s**: 💰 $%s/s | ⚖️ %s KG", petName, incomeStr, weight))
                end
            end
        end
        if #maxPets > 0 then
            result = table.concat(maxPets, "\n")
        end
    end)
    return result
end
