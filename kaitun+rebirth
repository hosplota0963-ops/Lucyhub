                end
                local lower = string.lower(text):gsub("%s+", "")
                local nameLower = string.lower(desc.Name):gsub("%s+", "")
                if string.find(lower, "placebest") or string.find(lower, "bestpet") or string.find(lower, "equipbest") 
                    or string.find(nameLower, "placebest") or string.find(nameLower, "equipbest") then
