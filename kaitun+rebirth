local function isEggStillInMap(eggInstance)
    if not eggInstance or not eggInstance.Parent then return false end
    if not eggInstance:IsDescendantOf(workspace) then return false end
    local renderedEggs = workspace:FindFirstChild("RenderedEggs")
    if renderedEggs and not eggInstance:IsDescendantOf(renderedEggs) then return false end
    return true
end

local function findEggToFarm(targetEggs)
    local renderedEggs = workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return nil end
    
    -- Priority 1: บังคับเก็บ 3 เทพก่อนเสมอ (Cherub, Blackhole, Solaris)
    for _, pEgg in ipairs(GLOBAL_PRIORITY_EGGS) do
        for _, egg in ipairs(renderedEggs:GetChildren()) do
            if egg.Name == pEgg and isEggStillInMap(egg) then
                return egg
            end
        end
    end
    
    -- Priority 2: หาไข่เป้าหมายตามระดับ Rebirth
    for _, tEgg in ipairs(targetEggs) do
        for _, egg in ipairs(renderedEggs:GetChildren()) do
            if egg.Name == tEgg and isEggStillInMap(egg) then
                return egg
            end
        end
    end
    
    return nil
end

local function pickUpEgg(eggInstance)
    local char, hrp, hum = getChar()
    if not hrp then return false end
    
    local eggPos = eggInstance:GetPivot().Position
    
    -- ลูปแยกรัวปุ่ม E และสแปมเก็บของแบบขนาน ทำล่วงหน้าก่อนวาร์ปและทำต่อเนื่อง
    local isPickingUp = true
    task.spawn(function()
        while isPickingUp and eggInstance do
            -- 1. Touch
            pcall(function()
                if firetouchinterest then
                    local eggPart = eggInstance:IsA("BasePart") and eggInstance or eggInstance:FindFirstChildWhichIsA("BasePart", true)
                    if eggPart then
                        firetouchinterest(hrp, eggPart, 0)
                        firetouchinterest(hrp, eggPart, 1)
                    end
                end
            end)
            
            -- 2. Fire Remote
            local eggPickupEvent = GameRemotes:FindFirstChild("EggPickup")
            if eggPickupEvent then
                local eggUUID = eggInstance:GetAttribute("EggKey") or eggInstance.Name
                pcall(function() eggPickupEvent:FireServer(eggUUID) end)
            end
            
            -- 3. Proximity Prompt
            for _, desc in ipairs(eggInstance:GetDescendants()) do
                if desc:IsA("ProximityPrompt") then
                    desc.HoldDuration = 0
                    pcall(function() fireproximityprompt(desc) end)
                end
            end
            if eggInstance:IsA("ProximityPrompt") then
                eggInstance.HoldDuration = 0
                pcall(function() fireproximityprompt(eggInstance) end)
            end

            -- 4. กด E เสมือนรัวๆ
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.01)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end)
            task.wait(0.05)
        end
    end)
    
    -- วาร์ปไปที่ไข่ทันที (ระหว่างนี้ลูปสแปมกด E จะทำงานดักรอแล้ว)
    hrp.CFrame = CFrame.new(eggPos + Vector3.new(0, 1, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    
    -- รอให้ระบบสัมผัสและ Remote ทำงานเสร็จ
    task.wait(0.5)
    isPickingUp = false -- สั่งปิดลูปรัวปุ่ม E
    
    print("✅ สแปมปุ่มเก็บไข่เสร็จแล้ว! กำลัง Tween ลงพื้นเพื่อวาร์ปกลับบ้าน...")
    pcall(function()
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
    
    -- Tween ลงใต้ดินเหมือนเดิมเพื่อเลี่ยงตี้โกงยางยืด
    local TweenService = game:GetService("TweenService")
    local targetCFrame = hrp.CFrame - Vector3.new(0, 3000, 0)
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
    
    -- รอให้เกมส่งกลับบ้าน (เอาชัวร์ว่ากลับมาถึงฐานแล้วจริงๆ)
    local maxWait = 50
    while maxWait > 0 do
        local newChar, newHrp, _ = getChar()
        if newHrp then
            local myPlot = getMyPlot()
            if myPlot and myPlot:FindFirstChild("Baseplate") then
                local dist = (newHrp.Position - myPlot.Baseplate.Position).Magnitude
                if dist < 200 then
                    break -- กลับมาที่ฐานชัวร์ๆ แล้ว
                end
            elseif newHrp.Position.Y > -100 then
                break -- หาฐานไม่เจอ แต่ไม่ได้อยู่ใต้ดินแล้ว
            end
        end
        task.wait(0.1)
        maxWait = maxWait - 1
    end
    
    task.wait(0.5) -- รอให้โมเดลบ้านและไข่โหลดให้เสร็จ
    return true
end

