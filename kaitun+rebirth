local function scanBackpack()
    local eggCounts = {
        ["Cherub Egg"] = 0,
        ["Blackhole Egg"] = 0
    }
    local petCounts = {}
    local itemCounts = {}
    local totalPets = 0
    local totalItems = 0

    local containers = { localPlayer:FindFirstChild("Backpack"), localPlayer.Character }
    local seen = {}

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and not seen[item] then
                    seen[item] = true
                    local rawName = item.Name

                    if string.find(rawName, "Cherub") then
                        eggCounts["Cherub Egg"] = eggCounts["Cherub Egg"] + 1
                    elseif string.find(rawName, "Blackhole") or string.find(rawName, "Black Hole") then
                        eggCounts["Blackhole Egg"] = eggCounts["Blackhole Egg"] + 1
                    elseif string.find(rawName, "Egg") then
                        local cleanEggName = string.gsub(rawName, "%[.-%]", ""):gsub("^%s*(.-)%s*$", "%1")
                        eggCounts[cleanEggName] = (eggCounts[cleanEggName] or 0) + 1
                    else
                        local hasKg = string.find(rawName, "%[") and string.find(rawName, "KG")
                        local hasPetKey = item:GetAttribute("PetKey") or item:FindFirstChild("PetKey")
                        local cleanName = string.gsub(rawName, "%[.-%]", ""):gsub("^%s*(.-)%s*$", "%1")
                        local nameLower = string.lower(cleanName)

                        if hasKg or hasPetKey or SPECIES_PRIORITY[nameLower] then
                            petCounts[cleanName] = (petCounts[cleanName] or 0) + 1
                            totalPets = totalPets + 1
                        else
                            itemCounts[cleanName] = (itemCounts[cleanName] or 0) + 1
                            totalItems = totalItems + 1
                        end
                    end
                end
            end
        end
    end

    return eggCounts, petCounts, totalPets, itemCounts, totalItems
end

local function formatNumberSuffix(value)
    local num = tonumber(value)
    if not num then return "0" end
    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
    local suffixIndex = 1
    while num >= 1000 and suffixIndex < #suffixes do
        num = num / 1000
        suffixIndex = suffixIndex + 1
    end
    if suffixIndex > 1 then
        return string.format("%.2f%s", num, suffixes[suffixIndex])
    else
        return tostring(math.floor(num))
    end
end

