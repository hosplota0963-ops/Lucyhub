        for _, egg in ipairs(renderedEggs:GetChildren()) do
            if (egg.Name == priorityName or string.find(egg.Name, priorityName)) and isEggStillInMap(egg) then
                return egg
            end
        end
    end
    return nil
end

local function farmEggCycle(eggInstance)
    if isFarmingCycleActive then return end
    isFarmingCycleActive = true
    
    local eggName = eggInstance.Name
    local cleanName = string.gsub(eggName, "%[.-%]", ""):gsub("^%s*(.-)%s*$", "%1")
    local initialCount = 0
    pcall(function()
        local bp = localPlayer:FindFirstChild("Backpack")
        if bp then
            for _, item in ipairs(bp:GetChildren()) do
                if item.Name == cleanName or item.Name == eggName then
                    initialCount = initialCount + 1
                end
            end
        end
    end)

    -- ห้ามถือไอเท็มใดๆ ตอนฟาร์มไข่เด็ดขาด ไม่งั้นไข่ไม่ติดมือ
    pcall(function()
        local char = localPlayer.Character
        local bp = localPlayer:FindFirstChild("Backpack")
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:UnequipTools() end
            if bp then
                for _, item in ipairs(char:GetChildren()) do
                    if item:IsA("Tool") then
                        item.Parent = bp
                    end
                end
            end
        end
    end)

    local cycleSuccess, cycleErr = pcall(function()
        local eggName = eggInstance.Name

        setStatusText(string.format("🎯 กำลังพุ่งไป %s...", eggName))
        eggPickupSignal = false

        local pickupAttempts = 0
        local pickedUp = false
        local loopStart = tick()
        local maxWait = 14.0

        while scriptActive and (tick() - loopStart < maxWait) do
            if not isEggStillInMap(eggInstance) then
                pickedUp = true
                break
            end

            local hrp = getHRP()
            if not hrp then
                task.wait(0.15)
                continue
            end

            local eggPos = getEggPosition(eggInstance)
            if not eggPos then
                task.wait(0.1)
                if not isEggStillInMap(eggInstance) then
                    pickedUp = true
                    break
                end
                continue
            end

            pickupAttempts = pickupAttempts + 1

            local mod = pickupAttempts % 4
            local offset
            if mod == 1 then
                offset = Vector3.new(2.0, 0.4, 0)
            elseif mod == 2 then
                offset = Vector3.new(0, 0.4, 2.0)
            elseif mod == 3 then
                offset = Vector3.new(-2.0, 0.4, 0)
            else
                offset = Vector3.new(0, 1.2, 0)
            end

            local targetPos = eggPos + offset
            local targetCFrame = CFrame.new(targetPos, Vector3.new(eggPos.X, targetPos.Y, eggPos.Z))

            hrp.CFrame = targetCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.08)

            pcall(function()
                if firetouchinterest then
                    local eggPart = eggInstance:IsA("BasePart") and eggInstance or eggInstance:FindFirstChildWhichIsA("BasePart", true)
                    if eggPart then
                        firetouchinterest(hrp, eggPart, 0)
                        task.wait(0.01)
                        firetouchinterest(hrp, eggPart, 1)
                    end
                end
            end)

            for i = 1, 5 do
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.02)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    task.wait(0.02)
                end)
            end

            interactEgg(eggInstance)

            if not isEggStillInMap(eggInstance) then
                pickedUp = true
                break
            end

            task.wait(0.3)
        end

        if not isEggStillInMap(eggInstance) then
            pickedUp = true
        end

        if not pickedUp and isEggStillInMap(eggInstance) then
            setStatusText(string.format("⚠️ ยังเก็บ %s ไม่ติด จะลองใหม่ในรอบถัดไป...", eggName))
            task.wait(0.3)
            return
        end

        setStatusText(string.format("✅ ได้ %s แล้ว! กำลังมุดดินกลับบ้าน...", eggName))
        
        -- ลงใต้ดินทันทีเพื่อรับของ
        local hrpNow = getHRP()
        if hrpNow then
            tweenDownToDepth(hrpNow)
        end
        
        setStatusText(string.format("รอเซิร์ฟเวอร์ยืนยันไข่เข้ากระเป๋า...", eggName))
        
        local newlyFarmedWeight = nil
        local successFarmed = false
        
        for i = 1, 30 do -- รอสูงสุด 15 วินาที
            task.wait(0.5)
            pcall(function()
                -- เลิกถือของเผื่อมันเด้งเข้ามือ
