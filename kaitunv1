-- 3. Ultra Fast Feed Loop
task.spawn(function()
    local feedRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Game") and ReplicatedStorage.Remotes.Game:FindFirstChild("FeedPet")
    while scriptActive do 
        task.wait() -- All in อาหารแบบรัวที่สุด
        if getgenv().AutoFarmActive and feedRemote then
            pcall(function()
                local char = localPlayer.Character
                local backpack = localPlayer:FindFirstChild("Backpack")
                
                if char and backpack and not isFarmingCycleActive then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local foodsToSpam = {"Dragonfruit", "Magic Apple", "Meat", "Bone", "Grass"}
                    
                    -- ถือทีละชิ้นแล้วให้อาหารแบบสปีด
                    for _, foodName in ipairs(foodsToSpam) do
                        local tool = backpack:FindFirstChild(foodName) or char:FindFirstChild(foodName)
                        if tool and hum then
                            -- บังคับถืออาหารชิ้นนี้
                            if tool.Parent ~= char then
                                hum:EquipTool(tool)
                            end
                            
                            -- สแปมให้อาหารสัตว์ทุกตัวที่อยู่ในคลัง
                            for key, _ in pairs(cachedPetKeys) do
                                feedRemote:FireServer(key, foodName, true)
                            end
                        end
                    end
                    cachedPetKeys = {} -- ล้างแคชทันทีหลังส่งรีโมท ตามที่ผู้ใช้รีเควส
                end
            end)
            task.wait(1.5) -- หน่วง 1.5 วินาทีต่อ 1 รอบ
        end
    end
end)

-- 4. Auto Plant & Hatch (Limit 10 Eggs)
task.spawn(function()
    local hatchRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Game") and ReplicatedStorage.Remotes.Game:FindFirstChild("Hatch")
    local plantRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Game") and ReplicatedStorage.Remotes.Game:FindFirstChild("EggPlaced")
    
    setStatusText("🚀 เริ่มฟาร์ม...")
    
    while scriptActive do
        task.wait(0.5)
        if getgenv().AutoFarmActive then
            pcall(function()
                -- [0] ตรวจสอบไข่เทพในแมพก่อนเสมอ! ถ้ามีให้ไปเก็บทันทีแม้จะมีไข่ในตัว
                if not isFarmingCycleActive then
                    local targetEgg = findTargetEgg()
                    if targetEgg and targetEgg.Parent then
                        farmEggCycle(targetEgg)
                        return
                    end
                end

                -- ถ้าไม่มีไข่เทพในแมพ ให้ดึงไข่ในตัวมาปลูก
                local eggToPlant = getBestEggToPlant()

                local myPlot = getMyPlot()
                if not myPlot then return end
                
                local eggsFolder = myPlot:FindFirstChild("Eggs")
                
                -- [1] ฟักไข่ (ไข่ที่พร้อมเปิดแล้ว)
                if eggsFolder and hatchRemote then
                    local uniqueEggs = {}
                    for _, obj in pairs(eggsFolder:GetChildren()) do
                        local key = extractKey(obj)
                        if key then uniqueEggs[key] = true end
                    end
                    
                    for key, _ in pairs(uniqueEggs) do
                        task.spawn(function() 
                            pcall(function() hatchRemote:FireServer({EggKey = key}) end)
                            pcall(function() hatchRemote:FireServer(key) end)
                            pcall(function() hatchRemote:FireServer({PetKey = key}) end)
                        end)
                    end
                end
                
                -- [2] ตรวจสอบไข่ & วางไข่ (ลิมิต 10 ฟองเป๊ะๆ เช็คแค่ในโฟลเดอร์ Eggs)
                local numEggs = eggsFolder and #eggsFolder:GetChildren() or 0
                if numEggs < 10 then
                    local baseplate = myPlot:FindFirstChild("Baseplate")
                    
                    if baseplate and eggToPlant and plantRemote then
                        local character = localPlayer.Character
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        
                        if humanoid and eggToPlant.Parent ~= character then
                            humanoid:EquipTool(eggToPlant)
                            task.wait(0.1) 
                        end
                        
                        local row = math.floor(getgenv().PlantIndex / GRID_COLUMNS) % GRID_ROWS
                        local col = getgenv().PlantIndex % GRID_COLUMNS
                        local offsetX = (col - (GRID_COLUMNS - 1) / 2) * SPACING
                        local offsetZ = (row - (GRID_ROWS - 1) / 2) * SPACING
                        getgenv().PlantIndex = getgenv().PlantIndex + 1
                        
                        plantRemote:FireServer({
                            PlantPosition = baseplate.Position + Vector3.new(offsetX, 0, offsetZ)
                        })
                    end
                else
                    -- ถมครบ 10 แล้ว ให้เก็บไข่ในมือเพื่อไม่ให้ยืนถือค้างไว้
                    local character = localPlayer.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        pcall(function() humanoid:UnequipTools() end)
                    end
                end
            end)
        end
    end
end)

