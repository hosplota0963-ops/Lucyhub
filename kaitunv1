        while tick() - startWait < 15.0 do
            local curChar = localPlayer.Character
            if curChar then
                local hrp = curChar:FindFirstChild("HumanoidRootPart")
                local hum = curChar:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 and baseplate then
                    -- เช็คระยะห่างแกน X, Z และเช็คว่าอยู่สูงกว่า Baseplate (เหยียบพื้นบ้านแล้ว)
                    local dist = (hrp.Position * Vector3.new(1, 0, 1) - baseplate.Position * Vector3.new(1, 0, 1)).Magnitude
                    if dist < 150 and hrp.Position.Y >= baseplate.Position.Y - 5 then
                        isHome = true
                        break
                    end
                end
            end
            task.wait(0.2)
        end
        
        -- รอให้ server จัดการตัวละครเด้งกลับมาเกิดที่บ้านให้เรียบร้อยก่อน (เอาชัวร์ๆ)
        setStatusText("⏳ รอเกิดที่บ้านให้สมบูรณ์...")
        task.wait(1.5)

        local nextEgg = findTargetEgg()
        if nextEgg then
            setStatusText("⭐ พบไข่เทพฟองอื่นในแมพ! กำลังไปเก็บต่อ...")
            return -- ออกเลยเพื่อไปเก็บฟองถัดไป ไม่ต้องทำเรื่องบ้าน
        end

        setStatusText("⏳ จัดการฟาร์ม...")
        task.wait(0.5)

        if CONFIG.HidePets then
            pcall(applyHidePets)
        end

        setStatusText("🥚 กำลังวางไข่...")
        pcall(autoPlaceEggsOnPlot)

        if CONFIG.AutoEquipBestPet then
            setStatusText("🐾 ลงสัตว์เลี้ยง...")
            pcall(function() placeBestPets(true) end)
        end

        if CONFIG.AutoBuyFood then
            pcall(triggerAutoBuyFood)
        end

        if INTERNAL.AutoHatchPlacedEggs or CONFIG.AutoHatchEggs then
            setStatusText("🐣 เช็คฟักไข่...")
            pcall(hatchReadyEggsOnPlot)
        end

        setStatusText("🟢 วนลูป...")
        task.wait(0.4)
    end)

    if not cycleSuccess and cycleErr then
        warn("[LUCY HUB RECOVERY]:", cycleErr)
    end

    isFarmingCycleActive = false
end

