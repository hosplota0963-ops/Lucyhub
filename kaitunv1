local function getEggSideTarget(eggInstance, prompt)
    local eggPos = getEggPosition(eggInstance)
    if not eggPos then return nil, nil end

    local refPart = nil
    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
        refPart = prompt.Parent
    elseif eggInstance:IsA("BasePart") then
        refPart = eggInstance
    elseif eggInstance:IsA("Model") then
        refPart = eggInstance.PrimaryPart or eggInstance:FindFirstChildWhichIsA("BasePart")
    end

    local basePos = (refPart and refPart.Position) or eggPos
    local offsetDir = Vector3.new(1, 0, 0)

    if refPart then
        local right = refPart.CFrame.RightVector
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatRight.Magnitude > 0.1 then
            offsetDir = flatRight.Unit
        else
            local look = refPart.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0.1 then
                offsetDir = flatLook.Unit
            end
        end
    end

    local testDir = offsetDir
    pcall(function()
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local filterList = { eggInstance }
        if localPlayer.Character then table.insert(filterList, localPlayer.Character) end
        rayParams.FilterDescendantsInstances = filterList
        local ray = Workspace:Raycast(basePos + Vector3.new(0, 1, 0), testDir * 3.5, rayParams)
        if ray then
            testDir = -testDir
        end
    end)
    offsetDir = testDir

    local targetPos = basePos + (offsetDir * 3) + Vector3.new(0, 0.4, 0)
    local targetCFrame = CFrame.new(targetPos, Vector3.new(basePos.X, targetPos.Y, basePos.Z))

    return targetPos, targetCFrame
end

local function isPlotEggReadyToHatch(eggInstance)
    if not eggInstance or not eggInstance.Parent then return false, nil end

    local prompt = eggInstance:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        for _, desc in ipairs(eggInstance:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                prompt = desc
                break
            end
        end
    end

    local hasTimerRunning = false
    local hasReadyText = false

    for _, desc in ipairs(eggInstance:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.lower(desc.Text or "")
            if string.find(txt, "ready") or string.find(txt, "hatch") or string.find(txt, "open") or string.find(txt, "claim") or string.find(txt, "ฟัก") then
                hasReadyText = true
            elseif string.match(txt, "%d+:%d+") or string.match(txt, "^%d+s$") or string.match(txt, "^%d+m$") then
                if txt == "00:00" or txt == "0:00" or txt == "0s" or txt == "0m" then
                    hasReadyText = true
                else
                    hasTimerRunning = true
                end
            end
        end
    end

    if hasTimerRunning and not hasReadyText then
        return false, prompt
    end

    if hasReadyText then
        return true, prompt
    end

    local readyAttr = eggInstance:GetAttribute("Ready") or eggInstance:GetAttribute("IsReady") or eggInstance:GetAttribute("CanHatch")
    if readyAttr == true then
        return true, prompt
    end

    local timeLeft = eggInstance:GetAttribute("TimeLeft") or eggInstance:GetAttribute("Timer")
    if timeLeft and type(timeLeft) == "number" then
        if timeLeft <= 0 then
            return true, prompt
        else
            return false, prompt
        end
    end

    if prompt and prompt.Enabled then
        local actText = string.lower(prompt.ActionText or "")
        local objText = string.lower(prompt.ObjectText or "")
        if string.find(actText, "hatch") or string.find(actText, "open") or string.find(actText, "claim")
            or string.find(objText, "hatch") or string.find(objText, "egg") or actText == "e" or actText == "" then
            return true, prompt
        end
    end

    return false, nil
end

