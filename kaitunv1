    end
    return nil
end

local function extractUUID(val)
    if not val then return nil end
    local str = tostring(val)
    local match = string.match(str, "%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x")
    if match then return match end
    match = string.match(str, "%w%w%w%w%w%w%w%w%-%w%w%w%w%-%w%w%w%w%-%w%w%w%w%-%w%w%w%w%w%w%w%w%w%w%w%w")
    if match then return match end
    return nil
end

local function getEggKeyFromInstance(egg)
    if not egg then return nil end

    local fromName = extractUUID(egg.Name)
    if fromName then return fromName end

    local directAttr = egg:GetAttribute("EggKey") or egg:GetAttribute("Key") or egg:GetAttribute("UUID") or egg:GetAttribute("Id")
    local fromDirect = extractUUID(directAttr)
    if fromDirect then return fromDirect end

    for _, v in pairs(egg:GetAttributes()) do
        local fromAttr = extractUUID(v)
        if fromAttr then return fromAttr end
    end

    for _, desc in ipairs(egg:GetDescendants()) do
        if desc:IsA("StringValue") then
            local fromVal = extractUUID(desc.Value)
            if fromVal then return fromVal end
        end
        local descDirect = desc:GetAttribute("EggKey") or desc:GetAttribute("Key") or desc:GetAttribute("UUID")
        local fromDesc = extractUUID(descDirect)
        if fromDesc then return fromDesc end

        for _, v in pairs(desc:GetAttributes()) do
            local fromDescAttr = extractUUID(v)
            if fromDescAttr then return fromDescAttr end
        end
    end

    return nil
end

local function scanAllPlotEggKeys()
    local foundKeys = {}
    local seen = {}

    local function addKey(key, eggInst)
        local uuid = extractUUID(key)
        if uuid and not seen[uuid] then
            seen[uuid] = true
            table.insert(foundKeys, { Key = uuid, Egg = eggInst })
        end
    end

    local plot = getMyPlot()
    if plot then
        local eggsFolder = plot:FindFirstChild("Eggs")
        if eggsFolder then
            for _, egg in ipairs(eggsFolder:GetChildren()) do
                local key = getEggKeyFromInstance(egg)
                if key then
                    addKey(key, egg)
                end
            end
        end

        local plotData = plot:FindFirstChild("Data") or plot:FindFirstChild("EggsData")
        if plotData then
            for _, desc in ipairs(plotData:GetDescendants()) do
                if desc:IsA("StringValue") then
                    addKey(desc.Value, nil)
                end
                for _, v in pairs(desc:GetAttributes()) do
                    addKey(v, nil)
                end
            end
        end
    end

    pcall(function()
        local savedData = localPlayer:FindFirstChild("SavedData")
        if savedData then
            for _, desc in ipairs(savedData:GetDescendants()) do
                if string.find(string.lower(desc.Name), "egg") or string.find(string.lower(desc.Name), "hatch") then
                    if desc:IsA("StringValue") then
                        addKey(desc.Value, nil)
                    end
                    for _, v in pairs(desc:GetAttributes()) do
                        addKey(v, nil)
                    end
                end
            end
        end
    end)

    return foundKeys
end

