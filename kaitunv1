                or effect:IsA("ColorCorrectionEffect") or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect")
                or effect:IsA("Atmosphere") or effect:IsA("Clouds") or effect:IsA("Sky") then
