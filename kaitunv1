-- การตั้งค่าระบบใหม่ (Ultra Fast Feed + 10 Eggs)
-- ==============================================
local eggPriority = {"Cherub Egg", "Solaris Egg", "Blackhole Egg", "Galxy Egg", "Galaxy Egg"}
local foodTypesToBuy = {"Dragonfruit", "Magic Apple", "Meat", "Bone", "Grass"}
local GRID_COLUMNS, GRID_ROWS, SPACING = 5, 5, 4
getgenv().PlantIndex = getgenv().PlantIndex or 0

local function extractKey(obj)
    if typeof(obj.Name) == "string" and string.match(obj.Name, "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") then
        return obj.Name
    elseif obj:IsA("StringValue") and (obj.Name == "EggKey" or obj.Name == "PetKey" or obj.Name == "UUID") then
        return obj.Value
    elseif obj:GetAttribute("EggKey") or obj:GetAttribute("PetKey") then
        return obj:GetAttribute("EggKey") or obj:GetAttribute("PetKey")
    end
    return nil
end

local function scanAllPetsBypass()
    local keys = {}
    local myPlot = getMyPlot()
    if myPlot then
        -- หาใน Pets (สัตว์ที่ฟักแล้ว)
        local petsFolder = myPlot:FindFirstChild("Pets")
        if petsFolder then
            for _, obj in ipairs(petsFolder:GetChildren()) do
                local key = extractKey(obj)
                if key then keys[key] = true end
            end
        end
        
        -- หาใน Eggs (ไข่ที่เพิ่งวาง ต้องป้อนอาหารให้มันฟัก!)
        local eggsFolder = myPlot:FindFirstChild("Eggs")
        if eggsFolder then
            for _, obj in ipairs(eggsFolder:GetChildren()) do
                local key = extractKey(obj)
                if key then keys[key] = true end
            end
        end
    end
    return keys
end

local function getBestEggToPlant()
    local character, backpack = localPlayer.Character, localPlayer:FindFirstChild("Backpack")
    for _, eggName in ipairs(eggPriority) do
        if character and character:FindFirstChild(eggName) then return character[eggName] end
        if backpack and backpack:FindFirstChild(eggName) then return backpack[eggName] end
    end
    return nil
end

