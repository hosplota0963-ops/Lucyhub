local isFarmingCycleActive = false

local function tweenDownToDepth(hrp)
    if not hrp or not hrp.Parent then return end
    local char = hrp.Parent

    -- วาร์ปลงใต้ดิน -40000 ทันทีแล้วปล่อยร่วงแบบ No Clip เพื่อให้เซิร์ฟเด้งกลับบ้านเอง (ห้ามตาย)
    local currentPos = hrp.Position
    local targetY = -40000
    local targetPos = Vector3.new(currentPos.X, targetY, currentPos.Z)
    
    -- ทำ No-clip เพื่อให้ร่วงทะลุทุกอย่างลงไปแบบไม่ติดขัด
    pcall(function()
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)

    -- วาร์ปลงไปลึกๆ แล้วปล่อยให้เกมดึงกลับบ้านเอง
    hrp.CFrame = CFrame.new(targetPos)
    hrp.AssemblyLinearVelocity = Vector3.new(0, -500, 0) -- ดิ่งลงต่อเร็วๆ
end

local function isEggStillInMap(eggInstance)
