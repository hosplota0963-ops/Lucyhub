local function getMaskedName(name)
    local str = tostring(name or (localPlayer and localPlayer.Name) or "Player")
    local len = #str
    if len <= 4 then
        local keep = math.max(1, math.min(len - 1, 2))
        return string.sub(str, 1, keep) .. "xxx"
    else
        return string.sub(str, 1, 4) .. "xxx"
    end
end

