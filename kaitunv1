local function getFreePlantPosition(plot, occupiedPositions)
    local baseplate = plot:FindFirstChild("Baseplate")
    if not baseplate then return nil end

    local hrp = getHRP()
    local baseCFrame = baseplate:IsA("BasePart") and baseplate.CFrame or CFrame.new(baseplate:GetPivot().Position)
    local centerPos = hrp and hrp.Position or baseCFrame.Position

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Include
    rayParams.FilterDescendantsInstances = { baseplate }

    for radius = 4, 16, 4 do
        for angle = 0, 315, 45 do
            local rad = math.rad(angle)
            local offsetX = math.cos(rad) * radius
            local offsetZ = math.sin(rad) * radius
            
            local testWorldPos = Vector3.new(centerPos.X + offsetX, centerPos.Y + 8, centerPos.Z + offsetZ)
            local ray = Workspace:Raycast(testWorldPos, Vector3.new(0, -20, 0), rayParams)
            
            if ray then
                local candidate = ray.Position
                local isFree = true
                for _, occPos in ipairs(occupiedPositions) do
                    local dist2D = (Vector2.new(candidate.X, candidate.Z) - Vector2.new(occPos.X, occPos.Z)).Magnitude
                    if dist2D < 3.2 then
                        isFree = false
                        break
                    end
                end

                if isFree then
                    return candidate
                end
            end
        end
    end

    local fallbackWorld = Vector3.new(centerPos.X, centerPos.Y + 8, centerPos.Z)
    local ray = Workspace:Raycast(fallbackWorld, Vector3.new(0, -20, 0), rayParams)
    return ray and ray.Position or centerPos
end

local function getEggWeight(tool)
    if not tool then return 0 end

    local attrWeight = tool:GetAttribute("Weight") or tool:GetAttribute("EggWeight") or tool:GetAttribute("BaseWeight")
    if attrWeight then
        local n = tonumber(tostring(attrWeight):gsub(",", ""))
        if n then return n end
    end

    for _, desc in ipairs(tool:GetDescendants()) do
        if desc:IsA("ValueBase") and (desc.Name == "Weight" or desc.Name == "EggWeight" or desc.Name == "BaseWeight") then
            local n = tonumber(tostring(desc.Value):gsub(",", ""))
            if n then return n end
        end
    end

    local name = tool.Name
    local bracketWeight = string.match(name, "%[%s*([%d%,%.]+)%s*[kK][gG]%s*%]") 
        or string.match(name, "%[%s*([%d%,%.]+)%s*%]")
        or string.match(name, "([%d%,%.]+)%s*[kK][gG]")
    if bracketWeight then
        local clean = bracketWeight:gsub(",", "")
        local n = tonumber(clean)
        if n then return n end
    end

    local anyNum = string.match(name, "(%d+%.?%d*)")
    if anyNum then
        return tonumber(anyNum) or 0
    end

    return 0
end

local function getSortedInventoryEggs(eggType)
    local eggs = {}
    local containers = { localPlayer:FindFirstChild("Backpack"), localPlayer.Character }

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local name = item.Name
                    local match = false
                    if eggType == "Cherub" and string.find(name, "Cherub") then
                        match = true
                    elseif eggType == "Blackhole" and (string.find(name, "Blackhole") or string.find(name, "Black Hole")) then
                        match = true
                    end

                    if match then
                        table.insert(eggs, {
                            Tool = item,
                            Name = name,
                            Weight = getEggWeight(item)
                        })
                    end
                end
            end
        end
    end

    table.sort(eggs, function(a, b)
        return a.Weight > b.Weight
    end)

    return eggs
end

local function placeEggTool(tool, plantPos, plot)
    local remote = getEggPlacedRemote()
    local char = getCharacter()
    local humanoid = getHumanoid()
    if not char or not humanoid then return false end

    local initialEggCount = 0
    local eggsFolder = plot:FindFirstChild("Eggs")
    if eggsFolder then
        initialEggCount = #eggsFolder:GetChildren()
    end

    local baseplate = plot:FindFirstChild("Baseplate")
    if not baseplate then return false end

    if tool.Parent ~= char then
        if tool.Parent == localPlayer:FindFirstChild("Backpack") then
            humanoid:EquipTool(tool)
            task.wait(0.3)
            if tool.Parent ~= char then
                tool.Parent = char
                task.wait(0.3)
            end
        else
            return false
        end
    end
    
    pcall(function() tool:Activate() end)
    task.wait(0.05)

    if firetouchinterest then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local handle = tool:FindFirstChild("Handle")
        if handle then
            pcall(function()
                firetouchinterest(handle, baseplate, 0)
                task.wait(0.05)
                firetouchinterest(handle, baseplate, 1)
            end)
        end
        if hrp then
            pcall(function()
                firetouchinterest(hrp, baseplate, 0)
                task.wait(0.05)
                firetouchinterest(hrp, baseplate, 1)
            end)
        end
    end

    -- Native Touched bypass by jumping/teleporting slightly on the baseplate
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        pcall(function()
            local originalCFrame = hrp.CFrame
            hrp.CFrame = originalCFrame + Vector3.new(0, 4, 0)
            task.wait(0.05)
            hrp.CFrame = originalCFrame
        end)
    end

    -- Shotgun Remote Payloads
    local remote = getEggPlacedRemote()
    if remote then
        pcall(function() remote:FireServer({ PlantPosition = plantPos }) end)
        pcall(function() remote:FireServer(baseplate, { PlantPosition = plantPos }) end)
        pcall(function() remote:FireServer(plantPos) end)
        pcall(function() remote:FireServer({ Target = baseplate, PlantPosition = plantPos }) end)
    end

    task.wait(0.15)

    local isPlaced = false
    local startTime = tick()
    while tick() - startTime < 0.5 do
        if eggsFolder and #eggsFolder:GetChildren() > initialEggCount then
            isPlaced = true
            break
        end
        if not tool.Parent or (tool.Parent ~= localPlayer:FindFirstChild("Backpack") and tool.Parent ~= char) then
            isPlaced = true
            break
        end
        task.wait(0.1)
    end

    humanoid:UnequipTools()
    task.wait(0.1)
    return isPlaced
end

