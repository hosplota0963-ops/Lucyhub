local function findTargetEgg()
    local renderedEggs = Workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return nil end

    local galaxyCount = 0
    local blackholeCount = 0
    local character = localPlayer.Character
    local backpack = localPlayer:FindFirstChild("Backpack")
    
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item.Name == "Galaxy Egg" or item.Name == "Galxy Egg" then galaxyCount = galaxyCount + 1 end
            if item.Name == "Blackhole Egg" then blackholeCount = blackholeCount + 1 end
        end
    end
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item.Name == "Galaxy Egg" or item.Name == "Galxy Egg" then galaxyCount = galaxyCount + 1 end
            if item.Name == "Blackhole Egg" then blackholeCount = blackholeCount + 1 end
        end
    end

    local priorityList = {"Cherub Egg", "Solaris Egg"}
    if blackholeCount < 10 then
        table.insert(priorityList, "Blackhole Egg")
    end
    if galaxyCount < 10 then
        table.insert(priorityList, "Galaxy Egg")
        table.insert(priorityList, "Galxy Egg")
    end
    
